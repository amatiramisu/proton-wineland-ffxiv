+    /* A monitor whose desktop differs from its native mode, or that moved because a desktop beside it
+     * grew, starts at its current position, where map_monitor_rect centres its mapping. */
+    if (type == MDT_DEFAULT && dpi &&
+        (current_mode.dmPelsWidth != source->physical.dmPelsWidth ||
