+static BOOL fs_hack_dldsr_model( VkExtent2D source, VkExtent2D target, UINT *model )
+{
+    static const UINT scales[] = {13333, 15000};
+    UINT i;
+
+    for (i = 0; i < ARRAY_SIZE(scales); i++)
+        if (source.width == (UINT)floor( target.width * (scales[i] / 10000.0) + 0.5 ) &&
+            source.height == (UINT)floor( target.height * (scales[i] / 10000.0) + 0.5 ))
+        {
+            *model = i;
+            return TRUE;
+        }
+    return FALSE;
+}
