+/* The asset directory opts this device into DL-DSR. Keep the ordinary DSR path
+ * available when any optional host capability is missing. The NVX importer
+ * validates the cubin's SM target before a function can be launched. */
+static void fs_hack_enable_dldsr( struct vulkan_physical_device *physical_device, VkDeviceCreateInfo *info,
+                                  struct mempool *pool, struct vulkan_device *device )
+{
+    struct vulkan_instance *instance = physical_device->instance;
+    VkPhysicalDeviceBufferDeviceAddressFeatures support = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES};
+    VkPhysicalDeviceFeatures2 features = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, &support};
+    VkPhysicalDeviceBufferDeviceAddressFeatures *bda;
+    VkPhysicalDeviceVulkan12Features *v12;
+    const VkDeviceGroupDeviceCreateInfo *group;
+    VkPhysicalDeviceProperties properties;
+    /* VK_NV_cuda_kernel_launch is provisional and omitted from Wine's public
+     * headers. Query its host property ABI solely to choose the cubin target. */
+    struct
+    {
+        VkStructureType sType;
+        void *pNext;
+        uint32_t computeCapabilityMinor, computeCapabilityMajor;
+    } cuda_properties = {(VkStructureType)1000307004};
+    VkPhysicalDeviceProperties2 properties2 = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &cuda_properties};
+    VkExtensionProperties *extensions;
+    PFN_vkGetPhysicalDeviceFeatures2 get_features;
+    PFN_vkGetPhysicalDeviceProperties2 get_properties2;
+    const char *path = getenv( "WINE_DLDSR_PATH" );
+    uint32_t count = 0, i, binary_version = 0, image_version = 0, sm;
+    BOOL cuda_properties_supported = FALSE;
+    VkResult res;
+
+    if (sizeof(void *) != 8 || !path || !*path || instance->api_version < VK_API_VERSION_1_1 ||
+        !device->extensions.has_VK_KHR_swapchain ||
+        !physical_device->extensions.has_VK_NVX_binary_import ||
+        !physical_device->extensions.has_VK_NVX_image_view_handle ||
+        !physical_device->extensions.has_VK_KHR_buffer_device_address ||
+        device->extensions.has_VK_EXT_buffer_device_address) return;
+
+    group = find_next_struct( info, VK_STRUCTURE_TYPE_DEVICE_GROUP_DEVICE_CREATE_INFO );
+    if (group && group->physicalDeviceCount > 1) return;
+    instance->p_vkGetPhysicalDeviceProperties( physical_device->host.physical_device, &properties );
+    if (properties.vendorID != 0x10de || properties.apiVersion < VK_API_VERSION_1_1) return;
+
+    get_features = instance->p_vkGetPhysicalDeviceFeatures2;
+    if (!get_features) get_features = instance->p_vkGetPhysicalDeviceFeatures2KHR;
+    if (!get_features) return;
+    get_features( physical_device->host.physical_device, &features );
+    if (!support.bufferDeviceAddress) return;
+
+    res = instance->p_vkEnumerateDeviceExtensionProperties( physical_device->host.physical_device, NULL, &count, NULL );
+    if (res || !count || !(extensions = calloc( count, sizeof(*extensions) ))) return;
+    res = instance->p_vkEnumerateDeviceExtensionProperties( physical_device->host.physical_device, NULL, &count, extensions );
+    if (!res)
+        for (i = 0; i < count; i++)
+        {
+            if (!strcmp( extensions[i].extensionName, VK_NVX_BINARY_IMPORT_EXTENSION_NAME ))
+                binary_version = extensions[i].specVersion;
+            if (!strcmp( extensions[i].extensionName, VK_NVX_IMAGE_VIEW_HANDLE_EXTENSION_NAME ))
+                image_version = extensions[i].specVersion;
+            if (!strcmp( extensions[i].extensionName, "VK_NV_cuda_kernel_launch" ))
+                cuda_properties_supported = TRUE;
+        }
+    free( extensions );
+    if (binary_version < 2 || image_version < 4 || !cuda_properties_supported) return;
+    get_properties2 = instance->p_vkGetPhysicalDeviceProperties2;
+    if (!get_properties2) get_properties2 = instance->p_vkGetPhysicalDeviceProperties2KHR;
+    if (!get_properties2) return;
+    get_properties2( physical_device->host.physical_device, &properties2 );
+    sm = cuda_properties.computeCapabilityMajor * 10 + cuda_properties.computeCapabilityMinor;
+    /* Ada executes Ampere's SM86 binary (same major, later minor). */
+    if (sm == 89) sm = 86;
+    if (sm != 75 && sm != 86 && sm != 120 && sm != 121) return;
+
+    v12 = (void *)find_next_struct( info, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES );
+    bda = (void *)find_next_struct( info, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES );
+    if (v12) v12->bufferDeviceAddress = VK_TRUE;
+    else if (bda) bda->bufferDeviceAddress = VK_TRUE;
+    else
+    {
+        if (!(bda = mem_alloc( pool, sizeof(*bda) ))) return;
+        *bda = support;
+        bda->bufferDeviceAddressCaptureReplay = VK_FALSE;
+        bda->bufferDeviceAddressMultiDevice = VK_FALSE;
+        bda->pNext = (void *)info->pNext;
+        info->pNext = bda;
+    }
+    device->extensions.has_VK_KHR_buffer_device_address = 1;
+    device->extensions.has_VK_NVX_binary_import = 1;
+    device->extensions.has_VK_NVX_image_view_handle = 1;
+    device->dldsr_sm = sm;
+    device->dldsr_enabled = TRUE;
+}
