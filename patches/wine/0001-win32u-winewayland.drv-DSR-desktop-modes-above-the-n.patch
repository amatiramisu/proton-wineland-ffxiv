+/* DSR-style resolutions above each monitor's native mode, as area factors of the native mode
+ * (4 = twice its width and height), by default NVIDIA's up to 4. Set with WINE_DSR_FACTORS or
+ * DsrFactors in the driver key, up to 4; an empty list or 0 disables them. */
+static float dsr_factors[16] = {1.20f, 1.50f, 1.78f, 2.00f, 2.25f, 3.00f, 4.00f};
+static UINT dsr_factor_count = 7;
 static UINT limit_resolutions = 0;
 BOOL decorated_mode = TRUE;
 UINT64 thunk_lock_callback = 0;
@@ -2493,6 +2499,42 @@ static UINT add_virtual_mode( DEVMODEW *modes, UINT count, const DEVMODEW *mode,
     return 2;
 }
 
+static void parse_dsr_factors( const char *list )
+{
+    dsr_factor_count = 0;
+    while (list && *list && dsr_factor_count < ARRAY_SIZE(dsr_factors))
+    {
+        char *end;
+        float factor = strtof( list, &end );
+        if (end == list)
+        {
+            list++;
+            continue;
+        }
+        if (factor > 1.0f && factor <= 4.0f) dsr_factors[dsr_factor_count++] = factor;
+        list = end;
+    }
+}
+
+/* The DSR size of a native size. NVIDIA's driver stores each factor as its per-axis scale times 10000
+ * (NVIDIA App: 10954 1.20x, 12247 1.50x, 13333 1.78x, 14142 2.00x, 15000 2.25x, 17320 3.00x, 20000 4.00x,
+ * 24494 6.00x, 30000 9.00x); those factors use the same scale, so 1.78x of 1920x1080 is 2560x1440. Other
+ * factors scale both axes by the square root of the area factor. */
+static DWORD dsr_size( DWORD native, float factor )
+{
+    static const struct { float area; UINT axis; } nvidia[] =
+    {
+        {1.20f, 10954}, {1.50f, 12247}, {1.78f, 13333}, {2.00f, 14142}, {2.25f, 15000},
+        {3.00f, 17320}, {4.00f, 20000}, {6.00f, 24494}, {9.00f, 30000},
+    };
+    double axis = sqrt( factor );
+    UINT i;
+
+    for (i = 0; i < ARRAY_SIZE(nvidia); i++)
+        if (fabs( factor - nvidia[i].area ) < 0.005) axis = nvidia[i].axis / 10000.0;
+    return (DWORD)floor( native * axis + 0.5 );
+}
