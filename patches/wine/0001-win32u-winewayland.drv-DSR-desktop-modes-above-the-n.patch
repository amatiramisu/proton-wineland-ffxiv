+static void destroy_dldsr_state( struct vulkan_device *device, struct swapchain *swapchain )
+{
+    struct fs_hack_dldsr *dl = &swapchain->dldsr;
+
+    if (dl->function) device->p_vkDestroyCuFunctionNVX( device->host.device, dl->function, NULL );
+    if (dl->module) device->p_vkDestroyCuModuleNVX( device->host.device, dl->module, NULL );
+    if (dl->weights) device->p_vkDestroyBuffer( device->host.device, dl->weights, NULL );
+    if (dl->memory) device->p_vkFreeMemory( device->host.device, dl->memory, NULL );
+    if (dl->layout) device->p_vkDestroyPipelineLayout( device->host.device, dl->layout, NULL );
+    if (dl->sampler) device->p_vkDestroySampler( device->host.device, dl->sampler, NULL );
+    memset( dl, 0, sizeof(*dl) );
+}
