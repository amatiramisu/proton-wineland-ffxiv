+/* The extractor authenticates the driver payloads before adapting their
+ * texture-handle ABI. A zero requested size accepts a bounded cubin; weights
+ * have an exact size shared by every architecture. */
+static void *fs_hack_dldsr_read( const char *directory, const char *name, size_t *size )
+{
+    size_t path_size = strlen( directory ) + strlen( name ) + 2, done = 0;
+    unsigned char *data = NULL;
+    struct stat st;
+    char *path;
+    ssize_t n;
+    int fd;
+
+    if (!(path = malloc( path_size ))) return NULL;
+    snprintf( path, path_size, "%s/%s", directory, name );
+    fd = open( path, O_RDONLY | O_CLOEXEC | O_NONBLOCK );
+    free( path );
+    if (fd < 0) return NULL;
+    if (fstat( fd, &st ) || !S_ISREG(st.st_mode) || st.st_size <= 0 || st.st_size > 1024 * 1024 ||
+        (*size && st.st_size != *size) || !(data = malloc( st.st_size ))) goto done;
+    *size = st.st_size;
+    while (done < *size)
+    {
+        n = read( fd, data + done, *size - done );
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0)
+        {
+            free( data );
+            data = NULL;
+            break;
+        }
+        done += n;
+    }
+done:
+    close( fd );
+    return data;
+}
