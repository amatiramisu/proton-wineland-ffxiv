     if (IsRectEmpty( &rect ))
     {
@@ -3751,19 +3870,23 @@ static struct monitor *get_monitor_from_rect( RECT rect, UINT flags, UINT dpi, M
     LIST_FOR_EACH_ENTRY(monitor, &monitors, struct monitor, entry)
