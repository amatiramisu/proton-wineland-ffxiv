+/* Return the DSR smoothness from 0 to 1, NVIDIA's DSR smoothness setting (WINE_DSR_SMOOTHNESS in percent) */
+static float fs_hack_dsr_smoothness(void)
+{
+    static float smoothness = -1.0f;
+    if (smoothness < 0.0f)
+    {
+        const char *e = getenv( "WINE_DSR_SMOOTHNESS" );
+        float percent = e ? strtof( e, NULL ) : 0.0f;
+        if (!(percent >= 0.0f)) percent = 0.0f;
+        if (percent > 100.0f) percent = 100.0f;
+        smoothness = percent / 100.0f;
+        TRACE( "dsr_smoothness: %.2f\n", smoothness );
+    }
+    return smoothness;
+}
+
+/* The exp2 coefficient of NVIDIA's DSR Gaussian for a scale per axis and a smoothness from 0 to 1
+ * (driver 621.14). Each step rounds to float as in the driver, and the division by ln 2 is in double.
+ * Scale 2 gives 0xc15bd6d6 at smoothness 0, 0xbf793425 at 0.33 and 0xbe5bd6db at 1. */
+static float dsr_coefficient( float scale, float smoothness )
+{
+    volatile float minimum, range, width, variance, exponent;
+
+    minimum = 0.5f / scale;
+    minimum = minimum + 0.025f;
+    range = 0.5f - minimum;
+    range = range * 3.0f;
+    width = smoothness * range;
+    width = width + minimum;
+    width = width * scale;
+    variance = width * width;
+    variance = variance - 0.25f;
+    exponent = variance + variance;
+    exponent = -1.0f / exponent;
+    return (float)((double)exponent / log( 2.0 ));
+}
+
+/* The scale per axis of a DSR desktop for the coefficient, and the source pixels for each destination
+ * pixel. NVIDIA's driver stores each DSR factor as its scale per axis times 10000 and draws a source
+ * extent into ceil(extent / scale) destination pixels, with 1 / scale as a float. */
+static void dsr_axis( UINT src, UINT dst, float *scale, float *ratio )
+{
+    static const UINT nvidia[] = { 10954, 12247, 13333, 14142, 15000, 17320, 20000 };
+    UINT i;
+
+    *scale = *ratio = (float)src / dst;
+    for (i = 0; i < ARRAY_SIZE(nvidia); i++)
+    {
+        volatile float inverse, extent;
+
+        if ((UINT)floor( dst * (nvidia[i] / 10000.0) + 0.5 ) != src) continue;
+        *scale = (float)nvidia[i] / 10000.0f;
+        inverse = 1.0f / *scale;
+        extent = (float)src * inverse;
+        *ratio = (float)src / (float)ceil( extent );
+        return;
+    }
+}
