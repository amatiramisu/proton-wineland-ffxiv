+/* A desktop larger than its native mode (DSR modes) grows right and down from its position; desktops
+ * beyond it move by the growth so all of them stay side by side, as on Windows. The primary keeps
+ * the origin. */
+static void place_grown_sources(void)
+{
+    struct source *source, *other, *primary = NULL;
+    POINT primary_shift = {0, 0};
+
+    LIST_FOR_EACH_ENTRY( source, &sources, struct source, entry )
+        if (source->state_flags & DISPLAY_DEVICE_PRIMARY_DEVICE) primary = source;
+
+    for (int pass = 0; pass < 2; pass++)
+    {
+        LIST_FOR_EACH_ENTRY( source, &sources, struct source, entry )
+        {
+            POINT shift = {0, 0};
+
+            if (!(source->state_flags & DISPLAY_DEVICE_ATTACHED_TO_DESKTOP)) continue;
+            LIST_FOR_EACH_ENTRY( other, &sources, struct source, entry )
+            {
+                LONG grow_x, grow_y;
+
+                if (other == source || !(other->state_flags & DISPLAY_DEVICE_ATTACHED_TO_DESKTOP)) continue;
+                grow_x = (LONG)other->current.dmPelsWidth - (LONG)other->physical.dmPelsWidth;
+                grow_y = (LONG)other->current.dmPelsHeight - (LONG)other->physical.dmPelsHeight;
+                if (grow_x > 0 && other->physical.dmPosition.x + (LONG)other->physical.dmPelsWidth <= source->physical.dmPosition.x)
+                    shift.x += grow_x;
+                if (grow_y > 0 && other->physical.dmPosition.y + (LONG)other->physical.dmPelsHeight <= source->physical.dmPosition.y)
+                    shift.y += grow_y;
+            }
+
+            if (!pass)
+            {
+                if (source == primary) primary_shift = shift;
+                continue;
+            }
+
+            shift.x -= primary_shift.x;
+            shift.y -= primary_shift.y;
+            if (!shift.x && !shift.y) continue;
+            source->current.dmFields |= DM_POSITION;
+            source->current.dmPosition.x = source->physical.dmPosition.x + shift.x;
+            source->current.dmPosition.y = source->physical.dmPosition.y + shift.y;
+            TRACE( "source %u moves to %d,%d beside a grown desktop\n", source->id,
+                   (int)source->current.dmPosition.x, (int)source->current.dmPosition.y );
+            if (source->key) write_source_mode( source->key, ENUM_CURRENT_SETTINGS, &source->current );
+        }
+    }
+}
